# ProjectFlow 2.0 — Environment Configuration
# Copy this to .env and update values

# Backend
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://jenjen@localhost:5432/projectflow

# Redis
REDIS_URL=redis://:redis_secret_2024@localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=projectflow

# JWT
JWT_SECRET=projectflow-secret-key-2024-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=projectflow-refresh-secret-2024
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:3000

# Environment
NODE_ENV=production
